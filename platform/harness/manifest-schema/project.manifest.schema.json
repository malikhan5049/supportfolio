{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supportfolio.local/project.manifest.schema.json",
  "title": "Project Manifest",
  "description": "Schema for a Supportfolio project manifest (project.manifest.yaml).",
  "type": "object",
  "required": [
    "id",
    "displayName",
    "shortDescription",
    "features",
    "exposedModules",
    "pipeline",
    "environments"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "shortDescription": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exposedModules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "remoteEntry"],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "remoteEntry": {
            "type": "string"
          }
        }
      },
      "contains": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "const": "card"
          }
        }
      }
    },
    "pipeline": {
      "type": "object",
      "required": ["stages"],
      "properties": {
        "stages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
