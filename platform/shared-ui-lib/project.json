{
  "name": "shared-ui-lib",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "platform/shared-ui-lib/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "platform/shared-ui-lib/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "platform/shared-ui-lib/jest.config.cts",
        "tsConfig": "platform/shared-ui-lib/tsconfig.spec.json"
      }
    }
  }
}
