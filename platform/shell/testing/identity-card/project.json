{
  "name": "identity-card",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "platform/shell/testing/identity-card/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:webpack-browser",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/platform/shell/testing/identity-card",
        "index": "platform/shell/testing/identity-card/src/index.html",
        "main": "platform/shell/testing/identity-card/src/main.ts",
        "tsConfig": "platform/shell/testing/identity-card/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "platform/shell/testing/identity-card/public",
            "output": "."
          }
        ],
        "styles": [
          "platform/shell/testing/identity-card/src/styles.css"
        ],
        "customWebpackConfig": {
          "path": "platform/shell/testing/identity-card/webpack.config.js"
        },
        "commonChunk": false,
        "extractLicenses": false
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "customWebpackConfig": {
            "path": "platform/shell/testing/identity-card/webpack.prod.config.js"
          }
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/angular:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "identity-card:build:production"
        },
        "development": {
          "buildTarget": "identity-card:build:development"
        }
      },
      "options": {
        "port": 4301,
        "publicHost": "http://localhost:4301",
        "headers": {
          "Access-Control-Allow-Origin": "*"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "identity-card:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "platform/shell/testing/identity-card/jest.config.cts",
        "tsConfig": "platform/shell/testing/identity-card/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "identity-card:build",
        "spa": true
      }
    }
  }
}