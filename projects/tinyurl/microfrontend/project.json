{
  "name": "tinyurl-microfrontend",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "projects/tinyurl/microfrontend/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:webpack-browser",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/projects/tinyurl/microfrontend",
        "index": "projects/tinyurl/microfrontend/src/index.html",
        "main": "projects/tinyurl/microfrontend/src/main.ts",
        "tsConfig": "projects/tinyurl/microfrontend/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "projects/tinyurl/microfrontend/public",
            "output": "."
          }
        ],
        "styles": ["projects/tinyurl/microfrontend/src/styles.css"],
        "customWebpackConfig": {
          "path": "projects/tinyurl/microfrontend/webpack.config.js"
        },
        "commonChunk": false,
        "extractLicenses": false
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "customWebpackConfig": {
            "path": "projects/tinyurl/microfrontend/webpack.prod.config.js"
          },
          "fileReplacements": [
            {
              "replace": "projects/tinyurl/microfrontend/src/environments/environment.ts",
              "with": "projects/tinyurl/microfrontend/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/angular:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4201,
        "publicHost": "http://localhost:4201",
        "headers": {
          "Access-Control-Allow-Origin": "*"
        },
        "proxyConfig": "projects/tinyurl/microfrontend/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "tinyurl-microfrontend:build:production"
        },
        "development": {
          "buildTarget": "tinyurl-microfrontend:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "tinyurl-microfrontend:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "projects/tinyurl/microfrontend/jest.config.cts",
        "tsConfig": "projects/tinyurl/microfrontend/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "tinyurl-microfrontend:build",
        "spa": true
      }
    }
  }
}
